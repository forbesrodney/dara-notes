{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "semi": false,
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "parser": "markdown"
      }
    },
    {
      "files": "*.html",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "*.css",
      "options": {
        "parser": "css",
        "singleQuote": false
      }
    },
    {
      "files": ["*.json", "*.code-workspace", "*.prettierrc", "*.snippets"],
      "options": {
        "parser": "json",
        "trailingComma": "none"
      }
    },
    {
      "files": "*.py",
      "options": {
        "parser": "python",
        "tabWidth": 4
      }
    },
    {
      "files": "*.php",
      "options": {
        "parser": "php",
        "tabWidth": 4
      }
    },
    {
      "files": ["*.c", "*.cpp", "*.cc", "*.h", "*.hpp"],
      "options": {
        "parser": "cpp",
        "tabWidth": 4
      }
    },
    {
      "files": ["*.java", "*.kt", "*.kts"],
      "options": {
        "parser": "java",
        "tabWidth": 4
      }
    }
  ]
}
