<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode doesn't generate (it adds the rest from the build settings). -->
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform needs this to draw at the display's full refresh rate. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
