<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode doesn't generate (it adds the rest from the build settings). -->
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform needs this to draw at the display's full refresh rate. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Uses only exempt encryption (standard HTTPS), so App Store Connect doesn't ask on each upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Background sync: an app refresh task (BackgroundSync in ui/src/iosMain). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.daranotes.sync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
