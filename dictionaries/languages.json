{
  "//": "The spelling dictionaries the app offers. build.py turns each into a word list; see README.md. Sources are npm packages, pinned to exact versions so a build only changes when this file does.",
  "languages": [
    { "code": "en-US", "name": "English (US)", "hunspell": "dictionary-en@4.0.0", "license": "MIT and BSD (SCOWL)" },
    { "code": "en-GB", "name": "English (UK)", "hunspell": "dictionary-en-gb@3.0.0", "license": "MIT and BSD (SCOWL)" },
    { "code": "es", "name": "Spanish", "hunspell": "dictionary-es@4.0.0", "license": "GPL 3, LGPL 3 or MPL 1.1" },
    { "code": "fr", "name": "French", "hunspell": "dictionary-fr@3.0.0", "license": "MPL 2.0" },
    { "code": "de", "name": "German", "hunspell": "dictionary-de@3.0.0", "license": "GPL 2 or GPL 3" }
  ],
  "extras": {
    "code": "software-terms",
    "name": "Software terms and company names",
    "license": "MIT",
    "lists": [
      { "package": "@cspell/dict-software-terms@5.4.9", "files": ["dict/softwareTerms.txt.gz", "dict/software-tools.txt", "dict/computing-acronyms.txt", "dict/networkingTerms.txt", "dict/webServices.txt", "dict/coding-compound-terms.txt"], "licenseFile": "LICENSE" },
      { "package": "@cspell/dict-companies@3.2.14", "files": ["dict/companies.txt"], "licenseFile": "LICENSE" }
    ]
  }
}
