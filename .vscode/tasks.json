{
  "version": "2.0.0",
  "options": {
    "env": {
      "JAVA_HOME": "/opt/homebrew/opt/openjdk@21",
      "ANDROID_HOME": "/opt/homebrew/share/android-commandlinetools"
    }
  },
  "tasks": [
    {
      "label": "Generate CHANGELOG.md",
      "type": "shell",
      "command": "git cliff -vv -o 2>&1 | grep 'Skipping commit' | sed -E 's/^.*Grouping error: //; s/`Skipping commit`/Skipping Commit :/'",
      "problemMatcher": []
    },
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build release APK",
      "type": "shell",
      "command": "./gradlew assembleRelease",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build release AAB",
      "type": "shell",
      "command": "./gradlew bundleRelease && echo && echo \"Bundle: app/build/outputs/bundle/release/foamforandroid-release.aab\"",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "./gradlew :shared:test testDebugUnitTest || { echo; echo \"Report: shared/build/reports/tests/test/index.html\"; exit 1; }",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install/Launch release APK",
      "type": "shell",
      "command": "$ANDROID_HOME/platform-tools/adb install -r app/build/outputs/apk/release/foamforandroid-release.apk && $ANDROID_HOME/platform-tools/adb shell am start -n app.foamforandroid/.MainActivity",
      "dependsOn": "Build release APK",
      "problemMatcher": []
    },
    {
      "label": "Install/Launch debug APK",
      "type": "shell",
      "command": "$ANDROID_HOME/platform-tools/adb install -r app/build/outputs/apk/debug/foamforandroid-debug.apk && $ANDROID_HOME/platform-tools/adb shell am start -n app.foamforandroid/.MainActivity",
      "dependsOn": "Build debug APK",
      "problemMatcher": []
    },
    {
      "label": "Start emulator",
      "type": "shell",
      "command": "$ANDROID_HOME/emulator/emulator -avd FoamForAndroid_API35",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Logcat (app only)",
      "type": "shell",
      "command": "$ANDROID_HOME/platform-tools/adb logcat --pid=$($ANDROID_HOME/platform-tools/adb shell pidof app.foamforandroid)",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Refresh bundled JS libraries",
      "type": "shell",
      "command": "scripts/fetch-vendor.sh",
      "problemMatcher": []
    },
    {
      "label": "Build markdownlint bundle",
      "type": "shell",
      "command": "scripts/build-markdownlint.sh",
      "problemMatcher": []
    },
    {
      "label": "Clean everything",
      "type": "shell",
      "command": "scripts/clean.sh",
      "problemMatcher": []
    },
    {
      "label": "Fetch build dependencies",
      "type": "shell",
      "command": "scripts/fetch-deps.sh",
      "problemMatcher": []
    },
    {
      "label": "Refresh everything",
      "type": "shell",
      "command": "scripts/refresh-all.sh",
      "problemMatcher": []
    },
    {
      "label": "Check for library updates",
      "type": "shell",
      "command": "scripts/check-updates.sh",
      "problemMatcher": []
    }
  ]
}
